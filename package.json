{
  "name": "eres-tu",
  "version": "1.0.0",
  "description": "¿Eres tú? — demo web de concienciación sobre deepfakes",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/sync-mediapipe.mjs",
    "dev": "next dev",
    "demo:simulada": "node scripts/demo-simulada.mjs",
    "prebuild": "node scripts/sync-mediapipe.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
