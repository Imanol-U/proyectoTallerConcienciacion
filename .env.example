# ¿Eres tú? — variables de entorno
# Copia este fichero a .env.local para desarrollar en tu máquina.
# En producción, defínelas en el panel de Railway / Fly.io (nunca en el repositorio).

# Clave de OpenRouter (https://openrouter.ai/keys). Solo se usa en el servidor;
# el navegador nunca la ve. Empieza por "sk-or-".
OPENROUTER_API_KEY=

# Modelo de vídeo en OpenRouter.
OPENROUTER_VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite

# Modelo de las escenas (Teletransporte, Bajo los focos): recibe la foto como
# referencia de identidad, no como primer fotograma. ~0,05 $/s a 480p.
OPENROUTER_SCENE_VIDEO_MODEL=x-ai/grok-imagine-video

# Límite de abuso. Los contadores viven en memoria y se reinician cada día (UTC).
# OJO: en un aula o un evento todo el mundo comparte la misma IP pública;
# sube MAX_PER_IP_PER_DAY para ese día o se acabará al tercer vídeo.
MAX_PER_IP_PER_DAY=3
MAX_GLOBAL_PER_DAY=200

# Interruptor de apagado. Solo el valor exacto "true" enciende la demo.
DEMO_ENABLED=true

# "true" = cámara y subida de fotos. Cualquier otro valor = solo cámara
# (recomendado si la demo se va a usar en un entorno con menores).
UPLOAD_ENABLED=true

# --- Opcionales ---------------------------------------------------------------

# Coste por vídeo, en euros (p. ej. 0.10). Mientras esté vacío, la web dice
# "céntimos" sin dar una cifra.
COST_PER_VIDEO_EUR=

# Datos que aparecen en /privacidad. Sin ellos, la página muestra un aviso
# "pendiente de completar".
ORG_NAME=
CONTACT_EMAIL=

# Cabecera de la que fiarse para conocer la IP del visitante. En Fly.io y en
# Railway se detecta sola. Defínela si pones un CDN delante
# (p. ej. cf-connecting-ip con Cloudflare).
CLIENT_IP_HEADER=

# Segundos máximos de espera al modelo antes de rendirse (5–280).
GENERATION_TIMEOUT_SECONDS=280

# Rutas, por si ffmpeg o la fuente no están en el sitio habitual.
# FFMPEG_PATH=ffmpeg
# WATERMARK_FONT_PATH=/app/fonts/Inter-Bold.ttf
